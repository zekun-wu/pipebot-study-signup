# --- Database (choose ONE) ---
# On Vercel with the Neon/Vercel Postgres integration, POSTGRES_URL is set automatically.
# Otherwise paste any Postgres connection string here:
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender address. Without a verified domain on Resend, use onboarding@resend.dev
EMAIL_FROM="AI Agent Study <onboarding@resend.dev>"
# Where admin notifications are sent:
ADMIN_EMAIL=you@example.com

# --- Microsoft Teams (remote sessions) ---
# Reusable Teams meeting link, sent automatically in remote participants'
# confirmation emails (and embedded in the calendar invite).
# Create one in Teams: Calendar -> New meeting -> copy the join link.
TEAMS_MEETING_LINK=

# --- Admin login ---
ADMIN_PASSWORD=change-me-please
# Optional: separate secret for signing the admin session cookie
# AUTH_SECRET=some-long-random-string
